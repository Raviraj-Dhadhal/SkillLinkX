<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="User.master.cs" Inherits="SkillLinkX.MasterPages.User" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SkillLinkX - Candidate Portal</title>

    <!-- Font-Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="<%= ResolveUrl("~/assets/CSS/user-master.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/assets/CSS/user-pages.css") %>" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Mobile Dim Overlay Backdrop -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- Desktop Grid Layout (260px Sidebar / 1fr Body) -->
        <div class="user-layout-grid">
            
            <!-- Left Sidebar -->
            <aside class="user-sidebar" id="userSidebar">
                <!-- Brand / Logo -->
                <div class="sidebar-brand">
                    <a href="<%= ResolveUrl("~/User/Dashboard.aspx") %>" class="sidebar-logo-link">
                        <img src='<%= ResolveUrl("~/assets/images/logo.svg") %>' alt="SkillLinkX Logo" class="sidebar-logo-img" />
                        <div class="sidebar-text-stack">
                            <span class="sidebar-logo-text">SkillLinkX</span>
                            <span class="sidebar-logo-sub">CANDIDATE HUB</span>
                        </div>
                    </a>
                </div>

                <!-- Primary Action Button -->
                <div class="sidebar-action-box">
                    <a href="<%= ResolveUrl("~/User/Jobs.aspx") %>" class="find-jobs-btn">
                        <i class="fa-solid fa-magnifying-glass"></i> Explore Jobs
                    </a>
                </div>

                <!-- Navigation Menu Links -->
                <nav class="sidebar-nav">
                    <ul>
                        <li><a href="<%= ResolveUrl("~/User/Dashboard.aspx") %>" class="sidebar-link"><i class="fa-solid fa-chart-pie"></i> Dashboard</a></li>
                        <li><a href="<%= ResolveUrl("~/User/Profile.aspx") %>" class="sidebar-link"><i class="fa-regular fa-user"></i> My Profile</a></li>
                        <li><a href="<%= ResolveUrl("~/User/Internships.aspx") %>" class="sidebar-link"><i class="fa-solid fa-graduation-cap"></i> Internships</a></li>
                        <li><a href="<%= ResolveUrl("~/User/Applications.aspx") %>" class="sidebar-link"><i class="fa-solid fa-file-signature"></i> Applications</a></li>
                        <li><a href="<%= ResolveUrl("~/User/SavedJobs.aspx") %>" class="sidebar-link"><i class="fa-regular fa-bookmark"></i> Saved Jobs</a></li>
                        <li><a href="<%= ResolveUrl("~/User/Interviews.aspx") %>" class="sidebar-link"><i class="fa-regular fa-calendar-check"></i> Interviews</a></li>
                        <li><a href="<%= ResolveUrl("~/User/Messages.aspx") %>" class="sidebar-link"><i class="fa-regular fa-comments"></i> Messages</a></li>
                        <li><a href="<%= ResolveUrl("~/User/Notifications.aspx") %>" class="sidebar-link"><i class="fa-regular fa-bell"></i> Notifications</a></li>
                        <li><a href="<%= ResolveUrl("~/User/ResumeBuilder.aspx") %>" class="sidebar-link"><i class="fa-regular fa-file-lines"></i> Resume &amp; Skills</a></li>
                        <li><a href="<%= ResolveUrl("~/User/CareerAssistant.aspx") %>" class="sidebar-link"><i class="fa-solid fa-robot"></i> AI Career Assistant</a></li>
                        <li><a href="<%= ResolveUrl("~/User/Settings.aspx") %>" class="sidebar-link"><i class="fa-solid fa-gear"></i> Settings</a></li>
                    </ul>
                </nav>

                <!-- Sidebar Footer Links -->
                <div class="sidebar-footer">
                    <a href="<%= ResolveUrl("~/Public/HelpCenter.aspx") %>" class="sidebar-footer-link"><i class="fa-regular fa-circle-question"></i> Help Center</a>
                    <a href="<%= ResolveUrl("~/Public/Login.aspx") %>" class="sidebar-footer-link logout"><i class="fa-solid fa-arrow-right-from-bracket"></i> Logout</a>
                </div>
            </aside>

            <!-- Right Body (75%) -->
            <div class="user-main-area">
                
                <!-- Top Header Bar -->
                <header class="user-topbar">
                    <!-- Left: Mobile Hamburger Icon -->
                    <button type="button" class="sidebar-toggle-btn" id="sidebarToggle" aria-label="Toggle Navigation">
                        <i class="fa-solid fa-bars"></i>
                    </button>

                    <!-- Center: Search Input -->
                    <div class="topbar-search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" placeholder="Search jobs, internships, skills..." />
                    </div>

                    <!-- Right: Quick Actions & Profile -->
                    <div class="topbar-actions">
                        <a href="<%= ResolveUrl("~/User/Notifications.aspx") %>" class="topbar-icon-btn" title="Notifications">
                            <i class="fa-regular fa-bell"></i>
                        </a>
                        <a href="<%= ResolveUrl("~/User/Messages.aspx") %>" class="topbar-icon-btn" title="Messages">
                            <i class="fa-regular fa-comment-dots"></i>
                        </a>
                        <a href="<%= ResolveUrl("~/User/Profile.aspx") %>" class="topbar-user-profile" style="text-decoration: none;">
                            <div class="user-avatar-chip">RD</div>
                            <div class="user-info-text">
                                <span class="user-name">Raviraj Dhadhal</span>
                                <span class="user-role">Software Developer</span>
                            </div>
                        </a>
                    </div>
                </header>

                <!-- Main Content Placeholder -->
                <main class="user-content-wrapper">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </main>

            </div>

        </div>
    </form>

    <!-- JS -->
    <script src="<%= ResolveUrl("~/assets/JS/user.js") %>"></script>
</body>
</html>
