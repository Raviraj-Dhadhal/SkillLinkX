<%@ Page Title="Discover Companies - SkillLinkX" Language="C#" MasterPageFile="~/MasterPages/Public.Master" %>

<asp:Content ID="headContent" ContentPlaceHolderID="head" runat="server">
</asp:Content>

<asp:Content ID="mainContent" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
    <div class="pub-container">
        
        <div class="section-heading" style="text-align: left; margin-bottom: 24px;">
            <h2>Discover Top Companies</h2>
            <p>Explore workplaces hiring active talent across technologies and domains</p>
        </div>

        <div class="grid-3-col">
            <div class="feature-card">
                <div class="feature-icon"><i class="fa-solid fa-building"></i></div>
                <h3>TechNova Solutions</h3>
                <p>Enterprise cloud and enterprise software solutions provider with over 500+ developers globally.</p>
                <div style="margin-top: 14px;">
                    <span class="meta-badge badge-blue">8 Open Jobs</span>
                    <span class="meta-badge">Ahmedabad, India</span>
                </div>
            </div>

            <div class="feature-card">
                <div class="feature-icon"><i class="fa-solid fa-laptop-code"></i></div>
                <h3>Nexus Interactive</h3>
                <p>Digital product studio crafting state-of-the-art web, mobile, and interactive consumer experiences.</p>
                <div style="margin-top: 14px;">
                    <span class="meta-badge badge-blue">4 Open Jobs</span>
                    <span class="meta-badge">Bengaluru, India</span>
                </div>
            </div>

            <div class="feature-card">
                <div class="feature-icon"><i class="fa-solid fa-brain"></i></div>
                <h3>CognitiveScale</h3>
                <p>Applied AI and intelligent data engineering company pioneering modern workplace solutions.</p>
                <div style="margin-top: 14px;">
                    <span class="meta-badge badge-blue">6 Open Jobs</span>
                    <span class="meta-badge">Remote / Global</span>
                </div>
            </div>
        </div>

    </div>
</asp:Content>
